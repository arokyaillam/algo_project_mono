{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      // This is the line that fixes your error
      "@repo/typescript-config/*": ["packages/typescript-config/*"],
      
      // We also add paths for our other packages
      "@repo/data-fetcher/*": ["packages/data-fetcher/src/*"],
      "@repo/core-engine/*": ["packages/core-engine/src/*"],
      "@repo/ui/*": ["packages/ui/*"]
    }
  }
}